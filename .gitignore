# Godot 4+ specific ignores
.import/
.godot/
/android/

# Export configurations (re-generatable)
export.cfg
export_presets.cfg

# OS-specific junk
.DS_Store
Thumbs.db
desktop.ini

# IDE/editor configs
*.swp
*.swo

# Logs and temporary files
*.log
*.tmp

# Python virtualenvs or other local environments (if you use them)
venv/
.env/

# --- added by /dev-setup ---
.env
.env.*
!.env.example
.claude/trello-board
.claude/settings.local.json
.claude/plugins/
.claude/skills/
.work/PLAN.md
.work/FINDINGS.md
.work/PROGRESS.md
session-log.md
RELEASE-NOTES.md
.vscode/
.idea/

# Memory system — runtime artifacts (machine-local, not source)
/.memory/ARCHIVE-LOG.md
/.memory/EPISODIC-INDEX.md
/.memory/EPISODIC-ARCHIVE.md
/.memory/CONSOLIDATION-INBOX.md
.episodic-baseline
.episodic.lock

# git-crypt repo — override global ignore so encrypted files can commit
!/KNOWLEDGE.md
!/TODOS.md
!/.memory/SESSION-LOG.md
!/.work/PLAN.md
!/.work/FINDINGS.md
!/.work/PROGRESS.md
